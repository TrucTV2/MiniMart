APP_NAME="MiniMart POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.example.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=pos
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
REDIS_HOST=redis

FILESYSTEM_DISK=public

POS_STORE_NAME="MiniMart POS"
POS_BANK_BIN=970436
POS_BANK_ACCOUNT=0000000000

# true = tự nạp dữ liệu demo lần đầu (dùng cho bản demo trong CV)
SEED_DEMO=true
